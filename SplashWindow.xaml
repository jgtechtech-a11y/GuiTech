<Window x:Class="GuiTech.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gui_Tech" Width="360" Height="190"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- Cores fixas do tema escuro: o splash aparece antes do ThemeManager nascer. -->
    <Border Background="#070B0A" BorderBrush="#2D3331" BorderThickness="1" CornerRadius="12" Padding="24,18">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="Assets/logo-badge.png" Width="46" Height="46"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="19">
                        <Run Text="Gui" FontWeight="Bold" Foreground="#E0E5E3"/>
                        <Run Text="_Tech" FontWeight="Light" Foreground="#E0E5E3"/>
                    </TextBlock>
                    <TextBlock x:Name="VersionText" Text="" FontSize="11" Foreground="#7E8683" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Preparando o ambiente..." FontSize="12.5" Foreground="#A0A6A3"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Border>
</Window>
