<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A versão do SDK do Windows é necessária para as APIs nativas de pacotes (AppX),
         usadas pelo Debloat sem chamar o PowerShell. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>GuiTech</AssemblyName>
    <Product>Gui_Tech</Product>
    <Company>Gui_Tech</Company>
    <Version>0.25.16</Version>
    <!-- Sem isso, o build dentro do repositório git acrescenta o hash do commit no fim
         da versão exibida (ex.: 0.25.12+546ed9fe...) e o Setup fica com nome feio. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Projeto derivado de um projeto MIT: o aviso de copyright original esta no LICENSE. -->
    <!-- Sempre otimizado: o Gui_Tech BENCH e os stress tests precisam do JIT otimizado também em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-badge.png" />
    <Resource Include="Assets\logo-dark.png" />
  </ItemGroup>

  <!-- Os testes automáticos ficam em GuiTech.Tests\ (dentro do repositório, mas fora deste
       projeto). Sem estes Remove, o SDK pegaria os .cs e os bin\obj deles junto com o app. -->
  <ItemGroup>
    <Compile Remove="GuiTech.Tests\**" />
    <Page Remove="GuiTech.Tests\**" />
    <Resource Remove="GuiTech.Tests\**" />
    <None Remove="GuiTech.Tests\**" />
    <EmbeddedResource Remove="GuiTech.Tests\**" />
  </ItemGroup>

  <!-- Drivers seriais oficiais embutidos (Gui_Tech MAKER): cada pasta Drivers\<chip> vira recurso e é extraída na hora de instalar.
       Para incluir outro, basta criar a pasta com o .inf/.cat/.sys e ligá-la em MakerDrivers.Chips (Bundle). -->
  <ItemGroup>
    <EmbeddedResource Include="Drivers\**\*" Exclude="Drivers\*.md;Drivers\*.txt" LogicalName="Drivers/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- iCUE SDK da Corsair (Gui_Tech INTEGRAÇÃO): se a DLL estiver em Native\, ela vai junto do .exe. Não é versionada no git. -->
  <ItemGroup>
    <None Include="Native\iCUESDK.x64_2019.dll" Condition="Exists('Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Testes unitários acessam membros internos (ex.: parsing de versão do UpdateChecker). -->
  <ItemGroup>
    <InternalsVisibleTo Include="GuiTech.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

</Project>
